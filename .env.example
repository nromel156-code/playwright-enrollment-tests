# Copy this file to .env and fill it in. NEVER upload .env to GitHub.
BASE_URL=https://uat.bcas-oasis.com
ADMIN_USER=
ADMIN_PASS=

# Your OWN Junior High School test school year (create it once with "+ New" in School Years).
# Example: 2027-2028. Do NOT use 2026-2027, other groups are using it.
TEST_SCHOOL_YEAR=2027-2028

# The shared school year the scripts must never change.
SHARED_SCHOOL_YEAR=2026-2027
